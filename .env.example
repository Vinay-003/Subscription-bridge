# SubscriptionBridge Environment Configuration
# Copy this to .env and fill in your values.

# Default provider (gemini, chatgpt, claude, or fake)
BRIDGE_DEFAULT_PROVIDER=fake

# Logging level (DEBUG, INFO, WARNING, ERROR)
BRIDGE_LOG_LEVEL=INFO

# Log format (json, console)
BRIDGE_LOG_FORMAT=console

# Chrome / Browser Configuration
# Set to "managed" for Playwright-managed browser, "cdp" for connecting to existing Chrome
BRIDGE_BROWSER_MODE=managed

# CDP URL for connecting to existing Chrome (only used when BRIDGE_BROWSER_MODE=cdp)
# Default: http://127.0.0.1:9333
BRIDGE_CDP_URL=http://127.0.0.1:9333

# Browser headless mode (true/false)
BRIDGE_HEADLESS=false

# Path to Chrome browser binary (leave empty for system default)
BRIDGE_CHROME_PATH=

# API Server
BRIDGE_API_HOST=127.0.0.1
BRIDGE_API_PORT=8742

# Session Pool
BRIDGE_MAX_CONCURRENT_SESSIONS=4
BRIDGE_SESSION_TTL_SECONDS=600
